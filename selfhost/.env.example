APP_DOMAIN=ritm.example.com
BETTER_AUTH_URL=https://ritm.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
POSTGRES_DB=ritm
POSTGRES_USER=ritm
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://ritm:replace-with-a-long-random-password@db:5432/ritm

# Optional: Google OAuth. Callback: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Ссылка iCloud на готовую команду «Быстрых команд» для Apple Health.
# Публичная копия команды должна быть БЕЗ личного ключа: каждый вставляет свой.
NEXT_PUBLIC_HEALTH_SHORTCUT_URL=
