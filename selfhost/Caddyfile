# Общая конфигурация приложения: apex и www обслуживаются одинаково.
# Редиректа между ними нет намеренно — если у одного из хостов ломается DNS,
# второй продолжает работать.
(ritm) {
  encode zstd gzip
  reverse_proxy app:3000
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

{$APP_DOMAIN} {
  import ritm
}

www.{$APP_DOMAIN} {
  import ritm
}
